# .env.example

# Database
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/nova_kaitori

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Advertisement
AD_ENABLED=false
AD_PROVIDER=none
AD_CLIENT_ID=
AD_SLOT_ID=

# NOVA AI: Python package that provides answer(); empty = AI replies "unavailable"
AI_CORE_MODULE=nova_ai_core

# Lower-case username of the administrator account (empty = no administrator)
ADMIN_USERNAME=

FX_RATES_URL=https://open.er-api.com/v6/latest/JPY

# Member authentication
PUBLIC_APP_URL=http://localhost:5173
AUTH_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Password reset email (disabled until SMTP is configured)
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
