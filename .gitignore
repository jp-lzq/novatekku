# gitignore for the entire project

# Environment variables
.env
backend/.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!frontend/src/lib/
!frontend/src/lib/*.ts
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build outputs
dist/
dist-ssr/
*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db


# Database
*.db
*.sqlite
postgres_data/

# Logs
logs/
*.log
backend/celerybeat-schedule

# Local project notes / operational archives
PROJECT_STATE.md

# Session notes and memory files (never published)
MEMORY.md
memory/
AGENTS.md
SOUL.md
USER.md
